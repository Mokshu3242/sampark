ENV=dev

# Copernicus Data Space
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# LLM order: tried left to right, providers without keys are skipped
LLM_ORDER=groq,cloudflare,gemini

# Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_AUTH_TOKEN=
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CF_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

max_tokens=300

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MONGO_URI=mongodb+srv://MONGO_USERNAME:MONGO_PASSWORD@cluster0.n0gxsq5.mongodb.net/?appName=Cluster0
MONGO_USERNAME=
MONGO_PASSWORD=

B2_ENDPOINT=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=

CORS_ORIGINS=["http://localhost:5173"]

MALLOC_ARENA_MAX=2