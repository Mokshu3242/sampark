ENV=dev

# Copernicus Data Space (free account, Sentinel Hub OAuth client)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Copilot LLMs, tried left to right. Providers without a key are skipped.
LLM_ORDER=groq,cloudflare,gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CF_ACCOUNT_ID=
CF_AUTH_TOKEN=
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: run storage. Leave empty to keep runs on local disk only.
# Keep the MONGO_USERNAME / MONGO_PASSWORD words in the URI; they are filled in from the two lines below.
MONGO_URI=mongodb+srv://MONGO_USERNAME:MONGO_PASSWORD@<your-cluster>.mongodb.net/?appName=<your-app>
MONGO_USERNAME=
MONGO_PASSWORD=

B2_ENDPOINT=s3.<region>.backblazeb2.com
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=

# Frontend address(es), as JSON
CORS_ORIGINS=["http://localhost:5173"]

# Optional: lock new runs, Stop, Delete and the copilot behind a key
ACCESS_KEY=

# Where the pipeline runs: "local" (this machine) or "github" (GitHub Actions worker)
PIPELINE_MODE=local
GH_TOKEN=
GH_REPO=<owner>/<repo>